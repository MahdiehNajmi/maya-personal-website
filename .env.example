# Public site URL (used in metadata and Open Graph). On Vercel, VERCEL_URL is set automatically.
# Production URL (set on Vercel → Environment Variables)
NEXT_PUBLIC_SITE_URL=https://maya-personal-website.vercel.app

# Maya AI chat widget (Gemini 2.5 Flash) — server-side only, never expose to the browser
GEMINI_API_KEY=your_gemini_api_key_here

# Contact form (optional — without RESEND_API_KEY, form falls back to mailto)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Portfolio contact <onboarding@resend.dev>
# CONTACT_TO_EMAIL=mnajmi@mun.ca
